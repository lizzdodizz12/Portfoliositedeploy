{
  "buildCommand": "composer install --no-interaction --prefer-dist --optimize-autoloader && npm install && npm run build",
  "devCommand": "php artisan serve",
  "outputDirectory": "public",
  "framework": "laravel",
  "functions": {
    "api/index.php": {
      "runtime": "php-8.2"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production"
  }
}
